{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Nob built project with gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/blang",
            "args": [ "../b_src/return_lval.b" ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "preLaunchTask": "nob build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }/* ,
