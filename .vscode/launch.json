{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Nob Recipe (lldb)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/nob",
            "args": [
                "--debug"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Nob Recipe (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/nob",
            "args": [
                "--debug"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Nob built Project (lldb)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/blang",
            "preLaunchTask": "BuildWithNobDebug",
            "args": [
                "b_src/023-assignment.b"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Nob built Project (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/blang",
            "args": [
                "b_src/023-assignment.b"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "BuildWithNobDebug",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}